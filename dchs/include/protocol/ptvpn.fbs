namespace avpn;

enum pkt_type : byte {
	pt_tcp = 0,			// 原始的tcp ip包.
	pt_udp,				// 原始的udp ip包.
	pt_fec,				// Fec数据包, 指示包为FecMessageParity.
	pt_ctrl,			// 控制数据包.
	pt_auth,			// 认证数据包.
}

table FecMessage {
	pid: ubyte;		// 包id, 在组中的id.
	gid: long;		// group id.
	gsize: int;		// group 大小, 字节数.
	ds: ubyte;		// data shards.
	ps: ubyte;		// parity shards.
}

table Message {
	type: pkt_type;			// 包类型.
	fec_pkt: FecMessage;		// fec包.
	content: [ubyte];		// pt_tcp, pt_udp, pt_ctrl, pt_auth, shard 包.
}

root_type Message;
